# FinWise Node.js API Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Atlas URI (replace <username>, <password>, and <cluster>)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/financial_advisor?retryWrites=true&w=majority

# Strong random secret for signing JWT auth tokens
JWT_SECRET=replace-with-a-very-long-random-secret-string-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL (Must match your Render static site URL without trailing slash)
CLIENT_URL=https://finwise.onrender.com
CORS_ORIGIN=https://finwise.onrender.com

# ML Microservice URL (Your deployed Render ML Web Service URL or internal URL)
ML_SERVICE_URL=https://finwise-ml.onrender.com
ML_SERVICE_TIMEOUT=15000
