# ==========================================
# FinWise Environment Configuration (Root Example)
# ==========================================

# ----- Server Configuration -----
PORT=5000
MONGODB_URI=mongodb://localhost:27017/financial_advisor
JWT_SECRET=dev-secret-change-in-production-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ----- ML Microservice -----
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=15000
PYTHON_VERSION=3.11.8

# ----- Client Configuration -----
VITE_API_URL=http://localhost:5000

# ----- Google Gemini AI -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ----- Docker / Mongo Init -----
MONGO_INITDB_DATABASE=financial_advisor
